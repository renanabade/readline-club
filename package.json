{
  "name": "readline-club",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && wrangler dev --config wrangler.local.jsonc --port 8794",
    "dev:worker": "wrangler dev --config wrangler.local.jsonc --port 8794",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "npm run typecheck && npm test && npm run build",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --config wrangler.local.jsonc",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "npm run verify && npm run deploy:mailer && wrangler pages deploy dist --project-name readlineclub --branch main",
    "deploy:mailer": "wrangler deploy --config wrangler.mailer.jsonc --secrets-file .env.mailer",
    "build:mailer": "wrangler deploy --config wrangler.mailer.jsonc --dry-run",
    "build:pages": "wrangler pages functions build functions --outdir .wrangler/pages-check --compatibility-date 2026-09-27 --compatibility-flags nodejs_compat",
    "deploy:legacy": "wrangler deploy --config wrangler.legacy.jsonc",
    "cf:types": "wrangler types",
    "format": "prettier --write ."
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "hono": "^4.13.9",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "miniflare": "^5.20261001.0-alpha",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "wrangler": "^4.142.0"
  },
  "overrides": {
    "sharp": "^0.35.5"
  }
}
